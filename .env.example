# Copy to .env and change the password. .env is gitignored and must never be committed.
# No API keys exist here by design: KnowFlow needs no paid inference provider (ADR-007).

APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL 16 + pgvector (used by the API, scripts/db.ps1 and infra/docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=knowflow

# --- Local model runtime (Ollama). Tags are pinned; pull them yourself:
#   ollama pull qwen3:4b
#   ollama pull nomic-embed-text:v1.5
# On a 16GB+ RAM machine you may use qwen3:8b instead (TRD §4.1).
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first (~2s delay).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5

HEALTH_CHECK_TIMEOUT_SECONDS=3

# --- Web (Next.js). The browser calls same-origin /api/v1/*, proxied to this URL.
API_INTERNAL_URL=http://127.0.0.1:8000

# Copy to .env and change the password. .env is gitignored and must never be committed.
# No API keys exist here by design: KnowFlow needs no paid inference provider (ADR-007).

APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL 16 + pgvector (used by the API, scripts/db.ps1 and infra/docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=knowflow

# --- Local model runtime (Ollama). Tags are pinned; pull them yourself:
#   ollama pull qwen3:4b
#   ollama pull nomic-embed-text:v1.5
# On a 16GB+ RAM machine you may use qwen3:8b instead (TRD §4.1).
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first (~2s delay).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5

HEALTH_CHECK_TIMEOUT_SECONDS=3

# --- Model calls. CPU inference is slow; these bound every call (TRD §4.3).
EMBEDDING_BATCH_SIZE=16
GENERATION_TIMEOUT_SECONDS=300
GENERATION_NUM_CTX=4096
# Optional local reranker (pip install -e "apps/api[reranker]"); off until measured (M5).
ENABLE_RERANKER=false

# --- Ingestion limits (TRD §12)
MAX_PDF_PAGES=500
EXTRACTION_TIMEOUT_SECONDS=120
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# --- Web (Next.js). The browser calls same-origin /api/v1/*, proxied to this URL.
API_INTERNAL_URL=http://127.0.0.1:8000

# --- SQL Analyst (TRD §10). `./scripts/dev.ps1 seed-demo` creates a separate synthetic database
# and a SELECT-only login role with this password (12+ characters).
DEMO_DB_READER_PASSWORD=change-me-reader-password
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=500
# Encrypts stored connection passwords (Fernet). Leave empty to auto-generate data/secret.key.
SECRET_KEY=
